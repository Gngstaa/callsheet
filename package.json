{
  "name": "callsheet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @callsheet/db generate && next build",
    "db:migrate": "pnpm --filter @callsheet/db exec prisma migrate deploy",
    "db:seed": "tsx scripts/seed.mts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@callsheet/db": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.5.0"
}
